# Ably API Key (from https://ably.com/dashboard)
# Get your API key from the Ably dashboard - it should have publish + subscribe + presence permissions
ABLY_API_KEY=your-ably-api-key-here

# Gemini API Key (from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=models/gemini-2.5-flash

# CopilotKit Cloud API Key (from https://cloud.copilotkit.ai)
# Or leave blank to self-host the runtime
COPILOTKIT_API_KEY=

# Member access tokens (comma-separated, simple secret tokens for demo)
# In production, replace with proper auth (NextAuth, Clerk, etc.)
MEMBER_TOKENS=token-alice,token-bob,token-carol,token-dave

# The community name shown in the UI
NEXT_PUBLIC_COMMUNITY_NAME=Your Community Name

# Ably channel name for the chat
NEXT_PUBLIC_CHAT_CHANNEL=community:members-only
